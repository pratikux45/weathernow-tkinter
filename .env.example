# Copy this file to `.env` and fill in your own values.
# Get a free OpenWeatherMap API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# "metric" -> Celsius / m/s   |   "imperial" -> Fahrenheit / mph
WEATHER_UNITS=metric

# Seconds to wait before an OpenWeatherMap request times out
REQUEST_TIMEOUT=10

# SQLite file used for search history (relative or absolute path)
DATABASE_NAME=weather_history.db

# Max number of search-history rows to keep
MAX_HISTORY_RECORDS=50

# Comma-separated list of allowed CORS origins, or "*" for any origin
# (the default "*" is fine for local dev / single-service deployment)
ALLOWED_ORIGINS=*
